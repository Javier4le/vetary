{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"files": {
		"ignore": [
			"**/dist/**",
			"**/node_modules/**",
			"**/coverage/**",
			"**/src/generated/**",
			"**/.codegraph/**",
			"**/.pi-lens/**"
		]
	},
	"linter": {
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"noUnreachable": "error",
				"noUndeclaredVariables": "error",
				"noConstAssign": "error"
			},
			"suspicious": {
				"noConsole": "error",
				"noDebugger": "error",
				"noDoubleEquals": "error",
				"noExplicitAny": "error",
				"noEmptyBlockStatements": "warn",
				"noGlobalIsNan": "error"
			},
			"style": {
				"useConst": "error",
				"useTemplate": "error",
				"noVar": "error",
				"useImportType": "off",
				"useNodejsImportProtocol": "warn",
				"useShorthandArrayType": "error",
				"noNonNullAssertion": "warn",
				"noParameterAssign": "error"
			},
			"complexity": {
				"noForEach": "warn",
				"noStaticOnlyClass": "error",
				"noUselessSwitchCase": "error",
				"noUselessConstructor": "warn",
				"useLiteralKeys": "warn"
			},
			"performance": {
				"noDelete": "warn"
			}
		}
	},
	"javascript": {
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		},
		"globals": [
			"afterAll",
			"afterEach",
			"beforeAll",
			"beforeEach",
			"describe",
			"expect",
			"it",
			"jest"
		]
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"organizeImports": {
		"enabled": true
	}
}
