# ===================================================================
# VETARY API — Variables de Entorno (Ejemplo)
# ===================================================================
# Copiar este archivo a .env y ajustar los valores reales
# ⚠️ NUNCA commitear .env — contiene secretos

# ===================================================================
# DATABASE
# ===================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vetary_dev"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vetary_dev

# ===================================================================
# JWT / AUTHENTICATION
# ===================================================================
# 🔒 SEGURIDAD: JWT_SECRET debe tener al menos 32 caracteres
# Generar con: openssl rand -base64 32
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_EXPIRATION="7d"

# ===================================================================
# BCRYPT
# ===================================================================
# Cost factor para bcrypt (10 es el estándar, mayor = más seguro pero más lento)
BCRYPT_ROUNDS=10

# ===================================================================
# CORS
# ===================================================================
# 🔒 SEGURIDAD: NUNCA usar '*' en producción
# Desarrollo: http://localhost:3001
# Producción: https://vetary.app,https://*.vetary.app
ALLOWED_ORIGINS="http://localhost:3001"

# ===================================================================
# APPLICATION
# ===================================================================
NODE_ENV=development
PORT=3000

# ===================================================================
# MULTI-TENANCY (Desarrollo)
# ===================================================================
# DEFAULT_TENANT_SUBDOMAIN permite testear en localhost sin configurar /etc/hosts
# Solo para desarrollo — deshabilitado en producción
DEFAULT_TENANT_SUBDOMAIN=

# ===================================================================
# RATE LIMITING
# ===================================================================
# Habilitar/deshabilitar rate limiting (útil para tests locales)
RATE_LIMIT_ENABLED=true
